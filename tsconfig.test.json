{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "types": ["node", "vscode", "mocha"],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "test/**/*"]
}
